@model List<Inventario_Productos_Tecnologicos.Models.ViewModels.ClienteMasComprasViewModel>


<div class="ClienteMasCompras">
    <h4 class="stats-title">Clientes con más compras</h4>
    <div class="stats-table">
        <div class="stats-table-header">
            <h5 class="stats-table-hearder-text stats-cont">Pos</h5>
            <h5 class="stats-table-hearder-text">Cliente</h5>
            <h5 class="stats-table-hearder-text stats-cont">Total</h5>
        </div>
        
        @if (Model.Count == 0)
        {
            <div class="stats-table-content">
                <div class="stats-item">
                    <h6>No hay clientes registrados</h6>
                </div>
                @if (Model.Count < 3)
                {
                    @for (var i = Model.Count; i < 2; i++)
                    {
                        {
                            <div class="stats-item">
                                <h6 class="stats-item-text">---------------------</h6>
                                <p class="stats-item-text">@(0.ToString("C", new System.Globalization.CultureInfo("es-CR")))</p>
                            </div>
                        }
                    }
                }
            </div>
        }
        else
        {
            <div class="stats-table-content">
                @{ var cont = 1; }  @* Declaración y inicialización correcta del contador *@
                @foreach (var cliente in Model)
                {
                    <div class="stats-item">
                        <span class="stats-item-text stats-cont">@(cont + ". ")</span>
                        <h6 class="stats-item-text">@(cliente.Usuario.TC_Nombre + " " + cliente.Usuario.TC_Apellidos)</h6>
                        <span class="stats-item-text stats-cont">@((cliente.TotalCompras ?? 0).ToString("C", new System.Globalization.CultureInfo("es-CR"))).</span>
                    </div>
                    cont++; @* Incrementa el contador en cada iteración *@
                }

                @{ var contExtra = Model.Count + 1; }  @* Declaración y inicialización correcta del contador *@
                @if (Model.Count < 3)
                {
                    for (var i = Model.Count; i < 3; i++)
                    {
                        <div class="stats-item">
                            <p class="stats-item-text stats-cont">@(contExtra + ". ")</p>
                            <h6 class="stats-item-text">---------------------</h6>
                            <p class="stats-item-text stats-cont">@(0.ToString("C", new System.Globalization.CultureInfo("es-CR")))</p>
                        </div>
                        contExtra++; @* Incrementa el contador en cada iteración *@
                    }
                }
            </div>
        }
    </div>
</div>