@model List<TECO_P_CarritoCompras>

@{

}

<dialog id="CarritoModal">
    <div class="modalContent">
        <h2>Carrito de compras</h2>
        <div class="Cart-header">
            <p>Productos en el carrito: <span id="cart-item-count">@(Model?.Count ?? 0)</span></p>
            <button class="btnClearCart">Vaciar carrito</button>
        </div>
        <div id="cart-item-container">
            @if (Model != null && Model.Count > 0)
            {
                decimal totalCarrito = 0; // Para calcular el total

                foreach (var item in Model)
                {
                    // Asegúrate de que item.Producto no sea null antes de acceder a sus propiedades
                    if (item.Producto != null)
                    {
                        <div class="cart-item">
                            <img src="@Url.Content(item.Producto.TC_Imagen)" alt="@item.Producto.TC_Nombre" class="cart-item-image" />
                            <div class="cart-item-details">
                                <h3>@item.Producto.TC_Nombre</h3>
                                <p>Cantidad: @item.TN_Cantidad</p>
                                <p>Precio Unitario: ₡ @item.TN_PrecioUnitario.ToString("N2")</p>
                                <p>Subtotal: ₡ @(item.TN_Cantidad * item.TN_PrecioUnitario).ToString("N2")</p>
                            </div>
                            <button class="remove-from-cart-btn" data-product-id="@item.TN_ProductoId">X</button>
                        </div>
                        totalCarrito += (item.TN_Cantidad * item.TN_PrecioUnitario); // Sumar al total
                    }
                }
                <p>Total: ₡ @totalCarrito.ToString("N2")</p>
            }
            else
            {
                <p>No hay productos en el carrito.</p>
            }
        </div>
        
        @* <p>Total: ₡ 0.00</p> *@
        
        <div class="form-group">
            <button type="button" class="btnClose" id="closeCart">Cerrar</button>
            <a class="btnEndCompra" asp-action="Carro_Compras" asp-controller="Ventas">Terminar compra</a>
        </div>
    </div>
</dialog>