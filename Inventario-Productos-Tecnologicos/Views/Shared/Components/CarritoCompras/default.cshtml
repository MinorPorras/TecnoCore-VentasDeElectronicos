@model List<TECO_P_CarritoCompras>

@{
    decimal totalCarrito = 0;
}

<dialog id="CarritoModal">
    <div class="modalContent">
        <h2>Carrito de compras</h2>
        <div class="Cart-header">
            <p>Productos en el carrito: <span id="cart-item-count">@(Model?.Count ?? 0)</span></p>
            <button class="btnClearCart">Vaciar carrito</button>
        </div>
        <div class="tableContainer">
            <div class="tbl-header tCart sticky-top">
                <span class="headerText">Nombre</span>
                <span class="headerText">Precio Unitario</span>
                <span class="headerText">Cantidad</span>
                <span class="headerText">Subtotal</span>
                <span class="headerText">Opciones</span>
            </div>
            @if (Model != null && Model.Count > 0)
            {

                <div class="tbl-content">
                    @if (Model.Count == 0)
                    {
                        <div class="tableRow">
                            <span class="NoElements">No hay @ViewBag.Title</span>
                        </div>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <div class="tableRow tCart">
                                <span class="tableCell">@item.Producto.TC_Nombre</span>
                                <span class="tableCell">@item.TN_Cantidad</span>
                                <span class="tableCell">₡ @item.TN_PrecioUnitario.ToString("N2")</span>
                                <span class="tableCell">₡ @((item.TN_Cantidad * item.TN_PrecioUnitario).ToString("N2"))</span>
                                <div class="tableButtonsColumn">
                                    <button type="button" 
                                            class="DeleteBtn tooltipContainer btnSwicthActive redHighlight">
                                        <img src="~/img/ICO_Delete.svg" alt="Desactivar" class="iconDeactivate"/>
                                        <span class="TooltipText transM50">Eliminar </span>
                                    </button>
                                </div>
                            </div>
                                
                            totalCarrito += item.TN_Cantidad * item.TN_PrecioUnitario; // Sumar al total
                        }
                    }
                </div>
            }
            else
            {
                <p>No hay productos en el carrito.</p>
            }
        </div>
        <p id="total-Cart">Total: ₡ @totalCarrito.ToString("N2")</p>
        <div class="form-group">
            <button type="button" class="btnClose" id="closeCart">Cerrar</button>
            <a class="btnEndCompra" asp-action="Carro_Compras" asp-controller="Ventas">Terminar compra</a>
        </div>
    </div>
</dialog>