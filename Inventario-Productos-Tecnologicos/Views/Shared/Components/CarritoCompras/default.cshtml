@model List<TECO_P_CarritoCompras>

@{
    decimal totalCarrito = 0;
}

<dialog id="CarritoModal">
    <div class="modalContent">
        <h2>Carrito de compras</h2>
        <div class="Cart-header">
            <p>Productos en el carrito: <span id="cart-item-count">@(Model?.Count ?? 0)</span></p>
            <button class="btnClearCart">Vaciar carrito</button>
        </div>
        <div class="tableContainer">
            <div class="tbl-header tCart sticky-top">
                <span class="headerText">Nombre</span>
                <span class="headerText">Precio Unitario</span>
                <span class="headerText">Cantidad</span>
                <span class="headerText">Subtotal</span>
                <span class="headerText">Opciones</span>
            </div>
            @if (Model != null && Model.Count > 0)
            {
                <div id="cart-item-list-container" class="tbl-content">
                    @foreach (var item in Model)
                    {
                        <div class="tableRow tCart">
                            <span class="tableCell">@item.Producto.TC_Nombre</span>
                            <span class="tableCell">₡ @item.TN_PrecioUnitario.ToString("N2")</span>
                            <div class="tableCell columnCant">
                                <button class="btnMinus" data-productid="@item.TN_ProductoId">
                                    <img src="@Url.Content("~/img/ICO_Minus.svg")" alt="-">
                                </button>
                                <input type="number" 
                                       class="inputBase cantInput cart-item-quantity" 
                                       value="@item.TN_Cantidad" 
                                       min="1" 
                                       max="@item.Producto.TN_Stock"
                                       data-productid="@item.TN_ProductoId"
                                       readonly />
                                <button class="btnPlus" data-productid="@item.TN_ProductoId">
                                    <img src="@Url.Content("~/img/ICO_Add.svg")" alt="+">
                                </button>
                            </div>
                            <span class="tableCell cart-item-subtotal">₡ @((item.TN_Cantidad * item.TN_PrecioUnitario).ToString("C", new System.Globalization.CultureInfo("es-CR")))</span>
                            <div class="tableButtonsColumn">
                                <button type="button" 
                                        class="DeleteBtn remove-from-cart-btn tooltipContainer btnSwicthActive redHighlight" 
                                        data-productId="@(item.TN_ProductoId)">
                                        <img src="~/img/ICO_Delete.svg" alt="Eliminar" class="iconDeactivate"/>
                                        <span class="TooltipText transM50">Eliminar </span>
                                </button>
                            </div>
                        </div>
                            
                        totalCarrito += item.TN_Cantidad * item.TN_PrecioUnitario; // Sumar al total
                    }
                </div>
            }
            else
            {
                <p>No hay productos en el carrito.</p>
            }
        </div>
        <p>Total: <span id="total-Cart">₡ @(Model?.Sum(item => item.TN_Cantidad * item.TN_PrecioUnitario).ToString("N2") ?? "0.00")</span></p>        <div class="form-group">
            <button type="button" class="btnClose" id="closeCart">Cerrar</button>
            <a class="btnEndCompra" asp-action="Carro_Compras" asp-controller="Ventas">Terminar compra</a>
        </div>
    </div>
</dialog>