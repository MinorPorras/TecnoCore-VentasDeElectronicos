@model System.Collections.Generic.List<Inventario_Productos_Tecnologicos.Models.ViewModels.MarcasMasVendidas>

<div class="MarcasMasVendidas">
    <h4>Marcas más vendidas</h4>
    <div class="stats-table">
        <div class="stats-table-header">
            <h5>Marcas</h5>
            <h5>Total</h5>
        </div>
        
        @if (Model.Count == 0)
        {
            <div class="stats-item">
                <h6>No hay categorías registrados</h6>
            </div>
            if (Model.Count < 5)
            {
                for (var i = Model.Count; i < 4; i++)
                {
                    <div class="stats-item">
                        <h6>---------------------------</h6>
                    </div>
                }
            }
        }
        else
        {
            foreach (var marca in Model)
            {
                <div class="stats-item">
                    <h6>@marca.Marca?.TC_Nombre</h6>
                    <p>@marca.TotalVentas.</p>
                </div>
            }
            if (Model.Count < 5)
            {
                for (var i = Model.Count; i < 5; i++)
                {
                    <div class="stats-item">
                        <h6>---------------------------</h6>
                    </div>
                }
            }
        }
    </div>
</div>