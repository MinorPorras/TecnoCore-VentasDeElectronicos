@model List<TECO_P_Pedido>

@{
    ViewBag.Title = "Pédidos";
    Layout = "_LayoutAdmin";
}

<h1>Pedidos</h1>

<div>
    <form asp-action="SearchPedidos" method="get">
        <h2>Pedidos pendientes: @Model.Count</h2>
        <div class="form-group">
            <label for="">Buscar:</label>
            <input type="text" name="searchTerm" class="form-control" placeholder="Ingrese el código de pedido o nombre del cliente" value="@ViewBag.searchTerm"/>
            <button type="submit" class="btn btn-primary mt-2">Buscar</button>
        </div>
        <div>
            <label for="estadoPedidoBusqueda">Estado del pedido</label>
            <select name="estadoPedidoBusqueda" id="estadoPedidoBusqueda" class="form-control">
                <option value="0">-- Seleccione un estado --</option> @* Opción por defecto para búsqueda *@
                @foreach (var estado in ViewBag.estadosPedidos as SelectList) // Castear a SelectList para Intellisense
                {
                    if (estado.Value == ViewBag.selectedEstadoBusqueda.ToString())
                    {
                        <option value="@estado.Value" selected>@estado.Text</option> 
                        continue; // Saltar al siguiente estado si ya se seleccionó
                    }
                    {
                        <option value="@estado.Value">@estado.Text</option>
                    }
                }
            </select>
        </div>
        <a asp-action="Pedidos_completados">Ver pedidos completados</a>
    </form>
</div>
@if (Model.Count <= 0)
{
    <p>No se encontraron pedidos.</p>
}
else{
    @foreach(var pedido in Model)
    {
    
        <form class="pedido" asp-action="ActualizarEstado" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="pedidoId" value="@pedido.TN_Id"/>
            <div class="Datos cliente">
                <p>Cod.Cliente: @pedido.Usuario?.Id</p>
                <p>Cliente: @pedido.Usuario?.TC_Nombre @pedido.Usuario?.TC_Apellidos</p>
                <p>Email: @pedido.Usuario?.Email</p>
                <p>Teléfono: @pedido.Usuario?.PhoneNumber</p>
            </div>
            <p>Código de pedido: @pedido.TN_TransaccionId</p>
            <p>Fecha: @pedido.TF_Fecha</p>
            <p>Método de pago: @pedido.MetodoPago?.TB_NombreMetodo</p>
            <div>
                <div>
                    <label for="estadoPedido_@pedido.TN_Id">Estado del pedido</label> @* ID único para cada select *@
                    <select name="estadoPedido" id="estadoPedido_@pedido.TN_Id" class="form-control"
                            asp-for="@pedido.TN_EstadoPedidoId"
                            asp-items="@ViewBag.estadosPedidos">
                    </select>
                </div>
            </div>
            <p>Dirección de Envío: @pedido.Usuario?.Direccion?.TC_Direccion</p>

            <h3>Detalles del Pedido:</h3>
            <ul>
                @foreach (var detalle in pedido.DetallePedidos)
                {
                    <li>@detalle.Producto?.TC_Nombre - Cantidad: @detalle.TN_Cantidad - Precio: @detalle.TN_PrecioUnitario</li>
                }
            </ul>
            <p>Subtotal: @pedido.TN_Subtotal</p>
            @if (pedido is { TN_CuponId: > 0, Cupon: not null })
            {
                <p>Cupon Aplicado: @pedido.Cupon.TC_Codigo</p>
            }
            <p>Descuento: @pedido.TN_Descuento</p>
            <p>Total: @pedido.TN_Total</p>

            <button type="submit" class="btn btn-success">Actualizar Estado</button>
        </form>
    }   
}
