@model Inventario_Productos_Tecnologicos.Models.ViewModels.RegisterViewModel
@{
    ViewBag.Title = "Información Personal";
    Layout = "_Layout";
}
<div class="pageContainer personalInfo">
    <h2 class="pageTitle personalInfo">Información Personal</h2>
    <a asp-action="Pedidos_Usuario" asp-controller="Pedidos" class="personalInfo-btn">Pedidos</a>
    <a asp-action="EditAccountInfo" asp-controller="Account" class="personalInfo-btn update">Actualizar
        información</a>
    <div class="accountForm">
        @Html.AntiForgeryToken()
        <div class="dataSeccion cuenta">
            <h4>Datos de la cuenta</h4>
            <div class="form-group">
                <label asp-for="UserName"></label>
                <label class="infoLabel">@Model.UserName</label>
            </div>

            <div class="form-group">
                <label asp-for="Email"></label>
                <label class="infoLabel">@Model.Email</label>
            </div>
        </div>
        <div class="dataSeccion personal">
            <h4>Datos Personales</h4>
            <div class="form-group">
                <label asp-for="Nombre"></label>
                <label class="infoLabel">@Model.Nombre</label>
            </div>
            <div class="form-group">
                <label asp-for="Apellidos"></label>
                <label class="infoLabel">@Model.Apellidos</label>
            </div>
            <div class="form-group">
                <label asp-for="PhoneNumber"></label>
                <label class="infoLabel">
                    @(!string.IsNullOrEmpty(Model.PhoneNumber) && Model.PhoneNumber.Length == 8
                        ? Model.PhoneNumber.Insert(4, "-")
                        : Model.PhoneNumber)
                </label>
            </div>
        </div>

        <div class="dataSeccion direccion">
            <h4>Dirección</h4>
            <div class="form-group">
                <label>Provincia</label>
                <label class="infoLabel">@ViewBag.ProvinciaName</label>
            </div>
            <div class="form-group mb-3">
                <label asp-for="SelectedCantonId"></label>
                <label class="infoLabel">@ViewBag.CantonName</label>
            </div>
            <div class="form-group">
                <label asp-for="DireccionExacta"></label>
                <label class="infoLabel">@Model.DireccionExacta</label>
            </div>
            <div class="form-group">
                <label asp-for="CodigoPostal"></label>
                <label class="infoLabel">@Model.CodigoPostal</label>
            </div>
        </div>
    </div>
</div>
