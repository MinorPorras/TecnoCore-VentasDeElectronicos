@model dynamic

@{
    ViewBag.Title = "Crear Roles";
    Layout = "_LayoutAdmin";
}
<div class="createContainer">
    <h2 class="pageTitle">Crear Roles</h2>

    <form asp-action="Create" method="post" class="createRolesForm">
        @Html.AntiForgeryToken()
        <div class="formgroup">
            <label for="Name">Nombre:</label>
            <input type="text" name="Name" id="Name" class="inputBase">
        </div>
        <div class="formgroup">
            <label for="TB_Activo">Estado:</label>
            <select name="TB_Activo" id="TB_Activo" class="inputBase">
                <option value="true">Activo</option>
                <option value="false">Inactivo</option>
            </select>
        </div>
        <div class="btngroup">
            <a type="button" asp-action="Index" class="btnExit">Regresar</a>
            <button type="submit" class="btnCreate">Guardar</button>
        </div>
    </form>
</div>

