@model Inventario_Productos_Tecnologicos.Models.TECO_A_Producto

@{
    if (User.IsInRole("Administrador"))
    {
        Layout = "_LayoutAdmin";
    }
    else
    {
        Layout = "_Layout";
    }
}
<div class="pageContainer">
    <div class="productDetailsContainer">
        <div class="productDetailsimageContainer">
            @if (!string.IsNullOrEmpty(Model.TC_Imagen))
            {
                <dd class="">
                    <img src="@Model.TC_Imagen" alt="Imagen de @Model.TC_Nombre"
                         style="max-width:200px; max-height:200px;"/>
                </dd>
            }
        </div>
        <div class="productDetails">
            <div class="dataGroup">
                <h4>@Model.TC_Nombre</h4>
            </div>
            
            <div class="dataGroup">
                <label class="">Descripción</label>
                <span class="">@Model.TC_Descripcion</span>
            </div>

            <div class="dataGroup">
                <label class="">Marca</label>
                <span class="">@Model.Marca?.TC_Nombre</span>
            </div>

            <div class="dataGroup">
                <label class="">Subcategoría</label>
                <span class="">@Model.Subcategoria?.TC_Nombre</span>
            </div>

            <div class="dataGroup">
                <label class="">Precio</label>
                <span class="">@Model.TN_Precio.ToString("C")</span>
            </div>

        </div>
        <div class="btnContainer">
            @if (User.IsInRole("Administrador"))
            {
                <a asp-action="Edit" asp-route-id="@Model.TN_Id" class="btn btn-warning">Editar</a>
            }
            <a onclick="window.history.back()" class="btn btn-danger">Regresar</a>
        </div>
    </div>
</div>
