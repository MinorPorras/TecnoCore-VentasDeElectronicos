@model Inventario_Productos_Tecnologicos.Models.TECO_A_Producto

@{
    if (User.IsInRole("Administrador"))
    {
        Layout = "_LayoutAdmin";
    }
    else
    {
        Layout = "_Layout";
    }
}
<div class="pageContainer">
    <div class="productDetailsContainer">
        <div class="productDetailsimageContainer">
            @if (!string.IsNullOrEmpty(Model.TC_Imagen))
            {
                <img src="@Model.TC_Imagen" alt="Imagen de @Model.TC_Nombre" class="productDetailsImage"/>
            }
        </div>
        <div class="productDetails">
            <h4 class="DetailsText-title bold">@Model.TC_Nombre</h4>
            <div class="dataGroup">
                <label class="DetailsText bold">Descripción:</label>
                <span class="DetailsText">@Model.TC_Descripcion</span>
            </div>

            <div class="cantGroup">
                <label class="DetailsText-header bold">Cantidad:</label>
                <button class="btnMinus">
                    <img src="~/img/ICO_Minus.svg" alt="-">
                </button>
                <input type="number" class="inputBase cantInput" value="1" min="1" max="@Model.TN_Stock"/>
                <button class="btnPlus">
                    <img src="~/img/ICO_Add.svg" alt="+">
                </button>
            </div>

            <div class="dataGroup dataType">
                <div class="dataType-sub">
                    <label class="DetailsText bold">Marca:</label>
                    <span class="DetailsText">@Model.Marca?.TC_Nombre</span>
                </div>
                <div class="dataType-sub">
                    <label class="DetailsText bold">Subcategoría:</label>
                    <span class="DetailsText">@Model.Subcategoria?.TC_Nombre</span>
                </div>
            </div>

            <div class="btnContainer">
                @if (User.IsInRole("Administrador"))
                {
                    <a asp-action="Edit" asp-route-id="@Model.TN_Id" class="btnEdit">Editar</a>
                }
                else
                {
                    <button class="btnAddToCart">
                        <img src="~/img/ICO_BolsaCompra.svg" alt="">
                        Agregar al carrito
                    </button>
                }
                <a onclick="window.history.back()" class="btnBack">Regresar</a>
            </div>

            <div class="dataGroup price">
                <label class="DetailsText-Price bold">Precio:</label>
                <span class="DetailsText-Price-red bold">@Model.TN_Precio.ToString("C")</span>
            </div>
        </div>
    </div>
</div>
