@model Inventario_Productos_Tecnologicos.Models.TECO_A_Producto

@{
    ViewBag.Title = "Editar Producto";
    if (User.IsInRole("Administrador"))
    {
        Layout = "_LayoutAdmin";
    }
    else if (User.IsInRole("Cliente"))
    {
        Layout = "_Layout";
    }
}

<div class="createContainer edit">
    <h1>Editar Producto</h1>

    <form asp-action="Create" method="post" enctype="multipart/form-data" class="createFormContainer product">
        <div class="createFormGroup codigo">
            <label asp-for="TC_Codigo"></label>
            <input asp-for="TC_Codigo" class="inputBase"/>
            <span asp-validation-for="TC_Codigo" class="text-danger"></span>
        </div>

        <div class="createFormGroup nombre">
            <label asp-for="TC_Nombre"></label>
            <input asp-for="TC_Nombre" class="inputBase"/>
            <span asp-validation-for="TC_Nombre" class="text-danger"></span>
        </div>

        <div class="createFormGroup descripcion">
            <label asp-for="TC_Descripcion"></label>
            <textarea asp-for="TC_Descripcion" class="inputBase"></textarea>
            <span asp-validation-for="TC_Descripcion" class="text-danger"></span>
        </div>
        <div class="createFormGroup previewProductImageContainer">
            <img id="preview" src="@Model.TC_Imagen" alt="Vista previa" class="previewProductImage"/>
        </div>

        <div class="createFormGroup gestionInventario">
            <label asp-for="TN_Stock">Gestión de inventario</label>
            <a asp-controller="Productos" asp-action="CreateKardexEntry" asp-route-id="@Model.TN_Id" class="btnExit">Entrada</a>
            <a asp-controller="Productos" asp-action="CreateKardexExit" asp-route-id="@Model.TN_Id" class="btnCreate">Salida</a>
        </div>

        <div class="createFormGroup marca">
            <label asp-for="TN_MarcaId"></label>
            <select asp-for="TN_MarcaId" class="inputBase" asp-items="ViewBag.MarcaId">
                <option value="">-- Seleccione Marca --</option>
            </select>
            <span asp-validation-for="TN_MarcaId" class="text-danger"></span>
        </div>

        <div class="createFormGroup subcategoria">
            <label asp-for="TN_SubcategoriaId"></label>
            <select asp-for="TN_SubcategoriaId" class="inputBase" asp-items="ViewBag.SubcategoriaId">
                <option value="">-- Seleccione Subcategoría --</option>
            </select>
            <span asp-validation-for="TN_SubcategoriaId" class="text-danger"></span>
        </div>

        <div class="createFormGroup novedad">
            <label asp-for="TB_Novedad" class="form-check-label"></label>
            <input asp-for="TB_Novedad" class="inputBase" type="checkbox"/>
        </div>

        <div class="createFormGroup precio">
            <label asp-for="TN_Precio"></label>
            <input asp-for="TN_Precio" class="inputBase" type="number" step="0.01" min="0"/>
            <span asp-validation-for="TN_Precio" class="text-danger"></span>
        </div>

        <div class="createFormGroup imagen">
            <label asp-for="TC_Imagen"></label>
            <input asp-for="TC_Imagen" class="inputBase" type="file" accept="image/*"
                   onchange="mostrarImagen(this)" id="imgSelector"/>
            <span asp-validation-for="TC_Imagen" class="text-danger"></span>
        </div>

        <div class="createFormGroup CreatebuttonGroup">
            <a asp-action="Index" class="btnExit">Cancelar</a>
            <button type="submit" class="btnEdit">Editar</button>
        </div>
    </form>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
