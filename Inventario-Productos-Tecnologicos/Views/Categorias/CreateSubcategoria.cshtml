@model TECO_M_Subcategoria

@{
    ViewBag.Title = "Crear Subcategoría";
    Layout = "_LayoutAdmin";
}

<div class="createContainer">
    <h2 class="pageTitle">Crear Subcategoría</h2>

    <form asp-action="CreateSubcategoria" method="post" class="createMarcaForm">
        @Html.AntiForgeryToken()
        <div class="formgroup">
            <label for="TC_Nombre">Nombre:</label>
            <input type="text" name="TC_Nombre" id="TC_Nombre" class="inputBase">
        </div>
        <input type="hidden" name="TN_CategoriaId" id="TN_CategoriaId" value="@ViewBag.CategoriaId">
        <div class="formgroup">
            <label for="TB_Activo">Estado:</label>
            <select name="TB_Activo" id="TB_Activo" class="inputBase">
                <option value="true">Activo</option>
                <option value="false">Inactivo</option>
            </select>
        </div>
        <div class="btngroup">
            <a asp-action="Edit" asp-route-id="@ViewBag.CategoriaId" class="btnExit">Regresar</a>
            <button type="submit" class="btnCreate">Guardar</button>
        </div>
    </form>
</div>
