@model TECO_A_Usuario

@{
    ViewBag.Title = "Actualizar Usuario";
    Layout = "_LayoutAdmin";
}

<div>
    <h2>Actualizar Usuario</h2>

    <form class="modifyElement">
        @Html.AntiForgeryToken()
        <input type="hidden" id="controller" name="controller" value="Usuarios"/>
        <input type="hidden" name="Id" value="@Model.Id"/>

        <div class="formgroup">
            <label asp-for="Email">Correo:</label>
            <input name="Email" type="email" class="form-control" value="@Model.Email">
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>
        <div class="formgroup">
            <label asp-for="TC_Nombre">Nombre:</label>
            <input name="TC_Nombre" type="text" class="form-control" value="@Model.TC_Nombre">
            <span asp-validation-for="TC_Nombre" class="text-danger"></span>
        </div>
        <div class="formgroup">
            <label asp-for="TC_Apellidos">Apellidos:</label>
            <input name="TC_Apellidos" type="text" class="form-control" value="@Model.TC_Apellidos">
            <span asp-validation-for="TC_Apellidos" class="text-danger"></span>
        </div>
        <div class="formgroup">
            <label asp-for="PhoneNumber">Teléfono:</label>
            <input name="PhoneNumber" type="tel" class="form-control" value="@Model.PhoneNumber">
            <span asp-validation-for="PhoneNumber" class="text-danger"></span>
        </div>
        <div class="formgroup">
            <label>Estado:</label>
            <div>
                <input type="radio" name="Activo" id="active" value="true" @(Model.TB_Activo == true ? "checked" : "")>
                <label for="active">Activo</label>

                <input type="radio" name="Activo" id="inactive" value="false"
                       @(Model.TB_Activo == false ? "checked" : "")>
                <label for="inactive">Inactivo</label>
            </div>
        </div>

        <div class="formgroup">
            <button type="button" id="updateBtn" class="btn btn-primary">Actualizar</button>
            <a asp-action="Index" class="btn btn-secondary">Volver</a>
        </div>
    </form>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script src="~/js/admin.js"></script>
}

