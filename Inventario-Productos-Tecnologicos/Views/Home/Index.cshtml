@{
    ViewData["Title"] = "Inicio";
}
<section class="cardWrapper createPC">
    <div class="InicioCard">
        <div class="title">Computadoras</div>
        <div class="curve-three"></div>
        <div class="curve-four"></div>

        <div class="card-image">
            <img src="img/BuildYourPC.jpg" alt="Crea Tu PC"/>
        </div>

        <div class="seeMore">
            <a asp-controller="Productos"
               asp-action="ListaProductos"
               asp-route-categoriaId="2"
               asp-route-subcategoriaId="0">
                Ver más
            </a>
        </div>
        <div class="curve-one"></div>
        <div class="curve-two"></div>
    </div>
</section>

<section class="cardWrapper components">
    <div class="InicioCard">
        <div class="title">Componentes</div>
        <div class="curve-three"></div>
        <div class="curve-four"></div>

        <div class="card-image">
            <img src="img/ComponentesPC.jpg" alt="Crea Tu PC"/>
        </div>

        <div class="seeMore">
            <a asp-controller="Productos"
               asp-action="ListaProductos"
               asp-route-categoriaId="1"
               asp-route-subcategoriaId="0">
                Ver más
            </a>
        </div>
        <div class="curve-one"></div>
        <div class="curve-two"></div>
    </div>
</section>

<section class="cardWrapper perifericos">
    <div class="InicioCard">
        <div class="title">Periféricos</div>
        <div class="curve-three"></div>
        <div class="curve-four"></div>

        <div class="card-image">
            <img src="img/perifericos.jpg" alt="Crea Tu PC"/>
        </div>

        <div class="seeMore">
            <a asp-controller="Productos"
               asp-action="ListaProductos"
               asp-route-categoriaId="3"
               asp-route-subcategoriaId="0">
                Ver más
            </a>
        </div>
        <div class="curve-one"></div>
        <div class="curve-two"></div>
    </div>
</section>

<section class="cardWrapper Novedades">
    <div class="InicioCard">
        @await Component.InvokeAsync("CarruselNovedades")
    </div>
</section>

<section class="list TarjetasGraficas">
    @await Component.InvokeAsync("ProductCardList", new { title = "Tarjetas Gráficas", subcategoryId = 3, categoryId = 1, lenght = 9 })
</section>

<section class="list Gabinetes">
    @await Component.InvokeAsync("ProductCardList", new { title = "Gabinetes", subcategoryId = 1, categoryId = 1, lenght = 9 })
</section>

<section class="list Perifericos">
    @await Component.InvokeAsync("ProductCardList", new { title = "Periféricos", subcategoryId = 0, categoryId = 3, lenght = 9 })
</section>