@model Inventario_Productos_Tecnologicos.Models.ViewModels.KardexViewModel

@{
    ViewBag.Title = "Crear entrada Kardex";
    Layout = "_LayoutAdmin";
}
<div class="kardexForm">
    <h2>Entrada de inventario</h2>
    <form asp-action="CreateEntry" method="Post" class="createKardexEntryForm">

        <div class="formGroup producto">
            <label asp-for="ProductoNombre">Producto</label>
            <input type="hidden" asp-for="ProductoId"  class="inputBase"/>
            <input class="form-control" asp-for="ProductoNombre" readonly/>
            <button type="button" class="btn btn-info mt-2" id="showModalBtn">Buscar Producto</button>
        </div>
        <div class="formGroup">
            <label asp-for="Fecha">Fecha:</label>
            <input type="date" asp-for="Fecha" class="inputBase" required/>
            <span asp-validation-for="Fecha" class="text-danger"></span>
        </div>
        <div class="formGroup">
            <label asp-for="TipoMovimientoId">Tipo de Movimiento</label>
            <select asp-for="TipoMovimientoId" class="inputBase"
                    asp-items="@ViewBag.TipoMovimientoId" required>
                <option value="">-- Seleccione Movimiento --</option>
            </select>
            <span asp-validation-for="TipoMovimientoId" class="text-danger"></span>
        </div>
        <div class="formGroup">
            <label asp-for="StockAnterior">Stock Anterior</label>
            <input asp-for="StockAnterior" class="inputBase" readonly/>
            <span asp-validation-for="StockAnterior" class="text-danger"></span>
        </div>
        <div class="formGroup">
            <label asp-for="Cantidad">Cantidad</label>
            <input asp-for="Cantidad" class="inputBase" required id="Cantidad"  min="1" value="1"/>
            <span asp-validation-for="Cantidad" class="text-danger"></span>
        </div>
        <div class="formGroup">
            <label asp-for="StockActual">Stock Nuevo</label>
            <input asp-for="StockActual" class="inputBase" readonly/>
            <span asp-validation-for="StockActual" class="text-danger"></span>
        </div>
        <div class="formGroup descripcion">
            <label asp-for="Descripcion">Descripción</label>
            <textarea asp-for="Descripcion" class="inputBase" rows="3"></textarea>
            <span asp-validation-for="Descripcion" class="text-danger"></span>
        </div>
        <div class="formGroup CreatebuttonGroup">
            <button type="submit" class="btnCreate">Guardar</button>
            <a onclick="Window.history.back()" class="btnExit">Cancelar</a>
        </div>
    </form>
</div>
<dialog class="SearchProductoDialog" id="searchProductoDialog">
    <div class="dialog-content">
        <button class="btn-close" onclick="document.getElementById('searchProductoDialog').close()" type="button"></button>
        <div class="tableContainer">
            <div class="tbl-header TRoles">
                <span class="headerText">Código</span>
                <span class="headerText">Nombre</span>
                <span class="headerText">Estado</span>
                <span class="headerText">Opciones</span>
            </div>
            <div class="tbl-content">
                @if (Model.ProductosDisponibles?.Count == 0)
                {
                    <div class="tableRow">
                        <span class="NoElements">No hay productos seleccionables</span>
                    </div>
                }
                else
                {
                    @foreach (var prod in Model.ProductosDisponibles)
                    {
                        <div class="tableRow TRoles">
                            <span class="tableCell">@prod.TC_Codigo</span>
                            <span class="tableCell">@prod.TC_Nombre</span>
                            <span class="tableCell">@prod.TN_Stock</span>
                            <div class="tableButtonsColumn">
                                <button type="button" class="btn btn-primary"
                                        data-producto-id="@prod.TN_Id"
                                        data-producto-nombre="@prod.TC_Nombre"
                                        onclick="selectProductoKardex('@prod.TN_Id', '@prod.TC_Nombre', true)">
                                    Seleccionar
                                </button>
                            </div>
                        </div>
                    }
                    <div class="tableRow listEnd">
                        <span>Fin de la Lista</span>
                    </div>
                }
            </div>
        </div>
    </div>
</dialog>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
