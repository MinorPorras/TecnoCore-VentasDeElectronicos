@model Inventario_Productos_Tecnologicos.Models.TECO_P_Kardex

@{
    ViewBag.Title = "Detalle Movimiento de Kardex";
    Layout = "_LayoutAdmin";
}

<div class="kardexMovementDetails">
    <h2 class="pageTitle">@ViewBag.Title</h2>
    <div class="kardexMovementDetailsCard">
        <div class="kardexMovementDetailsCardGroup">
            <h4>Producto:</h4>
            <span>@Model.Producto?.TC_Nombre</span>
        </div>
        <div class="kardexMovementDetailsCardGroup">
            <h4>Fecha:</h4>
            <span>@Model.TF_Fecha?.ToString("dd/MM/yyyy")</span>
        </div>
        <div class="kardexMovementDetailsCardGroup">
            <h4>Movimiento:</h4>
            <span>@Model.TipoMovimientoKardex?.TC_Tipo</span>
        </div>
        <div class="kardexMovementDetailsCardGroup">
            <h4>Stock Anterior:</h4>
            <span>@Model.TN_StockAnterior</span>
        </div>
        <div class="kardexMovementDetailsCardGroup">
            <h4>Cantidad:</h4>
            <span>@Model.TN_Cantidad</span>
        </div>
        <div class="kardexMovementDetailsCardGroup">
            <h4>Stock Nuevo:</h4>
            <span>@(Model.TN_StockActual ?? 0)</span>
        </div>
        <div class="kardexMovementDetailsCardGroup descText">
            <h4>Descripción:</h4>
                @if (string.IsNullOrWhiteSpace(Model.TC_Descripcion))
                {
                    <span>"Sin descripción"</span>
                }
                else
                {
                    <span>@Model.TC_Descripcion</span>
                }
        </div>
    </div>
    <a asp-action="Index" class="btnExit">Volver al listado</a>
</div>
